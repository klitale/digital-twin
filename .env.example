# ---------------------------------------------------------------------------
# digital-twin environment. Copy to .env and fill in. .env is gitignored.
# Model ids below are the ones available on the Timeweb AI Gateway as of the
# project start; check `client.models.list()` if a call fails with 404.
# ---------------------------------------------------------------------------

# --- Persona ---------------------------------------------------------------
# Name used in the persona prompt ("Ты — {name}"). Lives only in .env.
TWIN_NAME=

# --- Telegram identities ---------------------------------------------------
# Token from @BotFather. Business Mode must be enabled for this bot.
TG_BOT_TOKEN=
# Whose messages in the export are the replies to imitate. In the Desktop export
# the sender appears as from_id "user<ID>"; put only the number here.
TWIN_SENDER_ID=
# The account the bot is connected to via Telegram Business → Chatbots.
# business_connection.user_id must equal this id, otherwise the bot refuses to run.
BUSINESS_OWNER_ID=
# Accounts allowed to send /twin control commands in the bot's direct chat.
ADMIN_USER_IDS=
# Exactly two numeric user ids, comma-separated. The bot replies to nobody else.
ALLOWED_USER_IDS=
# Autopause duration after a message written by the owner in an allowlisted chat.
PAUSE_MINUTES=30
# rag | finetuned | hybrid
TWIN_MODE=rag
# true = full pipeline, replies are logged and never sent.
DRY_RUN=true
# Initiative (each feature is off until /followup on or /opener on in the bot chat).
# Local timezone and hours window in which the twin may write first; share of days
# with an opener; required silence; follow-up window after the twin's own reply.
INITIATIVE_TZ=Europe/Moscow
OPENER_HOURS=10-14
OPENER_DAILY_PROBABILITY=0.25
OPENER_SILENCE_HOURS=24
FOLLOWUP_MINUTES=20-90
FOLLOWUP_PROBABILITY=0.5

# --- Generation LLM (OpenAI-compatible gateway) ----------------------------
LLM_BASE_URL=https://api.timeweb.ai/v1
LLM_API_KEY=
# Thinking can be switched off for Qwen; DeepSeek V4 Flash keeps reasoning on via this gateway.
LLM_MODEL=dashscope/qwen3.5-flash

# --- Fine-tuned model (Modal, vLLM, OpenAI-compatible) ---------------------
# Filled after Phase 6: <modal app url>/v1
FT_BASE_URL=
# Bearer token you choose; the same value is deployed to Modal as MODAL_API_KEY.
FT_API_KEY=
# Adapter name served by vLLM: "base" until the real fine-tune, then "twin".
FT_MODEL=base
# Bounded wait for the (possibly cold) endpoint; the bot falls back to rag after it.
FT_TIMEOUT_SECONDS=25

# --- Judge (a different model family from the generator) -------------------
JUDGE_BASE_URL=https://api.timeweb.ai/v1
# Empty = reuse LLM_API_KEY when the base URL is the same.
JUDGE_API_KEY=
# Final runs: anthropic/claude-sonnet-4-6
JUDGE_MODEL=openai/gpt-5.4-mini

# --- Style profile (one-off) -----------------------------------------------
STYLE_PROFILE_MODEL=anthropic/claude-sonnet-4-6

# --- Embeddings ------------------------------------------------------------
# openai_compatible (default) | local_e5 (sentence-transformers, `uv sync --extra local-embed`)
EMBED_PROVIDER=openai_compatible
EMBED_BASE_URL=https://api.timeweb.ai/v1
# Empty = reuse LLM_API_KEY when the base URL is the same.
EMBED_API_KEY=
EMBED_MODEL=dashscope/text-embedding-v4
# Gateway limit: at most ~10 texts per embedding request; batches run in parallel workers.
EMBED_BATCH_SIZE=10
EMBED_WORKERS=4

# --- Modal (training job + serving app) ------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Hugging Face Hub (optional adapter mirror, private repo) --------------
HF_TOKEN=
HF_REPO_ID=

# --- Limits and paths ------------------------------------------------------
MAX_REPLY_CHARS=600
DATA_DIR=./data
# Telegram Desktop export; default: the only result.json found under data/raw/
RAW_EXPORT_PATH=./data/raw/result.json
